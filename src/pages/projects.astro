---
import MiniProject from "../components/MiniProject.svelte";
import MainLayout from "../layouts/MainLayout.astro";

interface ProjectMD {
  frontmatter: {
    title: string;
    description: string;
    date: string;
    link: string;
    url: string;
  };
}

const projects = Object.values(
  import.meta.glob<ProjectMD>("./projects/*.md", { eager: true }),
);
---

<MainLayout title="Projects • dwisarut">
  <main class="flex flex-col gap-6">
    <h1
      class="text-5xl md:text-6xl leading-16 lg:leading-28 lg:text-8xl font-bold text-nord0"
    >
      Projects
    </h1>
    <p class="text-[18px] lg:text-xl text-nord2">
      A page that displayed my prior projects.
    </p>

    <hr class="text-nord6" />

    <div class="flex flex-col gap-10">
      {
        projects.map((pj) => (
          <MiniProject
            title={pj.frontmatter.title}
            desc={pj.frontmatter.description}
            link={pj.frontmatter.link}
            showUrl={pj.frontmatter.url}
          />
        ))
      }
    </div>
  </main>
</MainLayout>
