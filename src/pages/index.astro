---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="dwisarut - Home">
  <div class="flex flex-col container py-16 gap-8 md:gap-12">
    <header>
      <h2
        class="text-[18px] lg:text-xl font-light text-zinc-600 tracking-wider"
      >
        Software Engineer
      </h2>
      <h1
        class="text-5xl md:text-6xl leading-16 lg:leading-28 lg:text-8xl font-bold text-zinc-700"
      >
        Wisarut Donsri
      </h1>
      <h3
        class="text-[18px] lg:text-xl font-normal text-zinc-500 tracking-wider"
      >
        Backend • Game development
      </h3>
    </header>

    <hr class="text-zinc-300" />

    <main class="flex flex-col gap-10 text-[18px] lg:text-xl text-zinc-600">
      <p>
        A self-taught developer that interested in a system designs, backend,
        and game development. Experienced in frontend and full-stack projects
        with freelance experiences. Currently pursuing MSc in Computer
        Engineering in <a class="text-amber-600 font-semibold">KMUTT</a>.
      </p>

      <p>
        Greatly fonds of the minimalistic and orderly design, especially <a
          class="text-zinc-500 font-semibold">Swiss</a
        > and <a class="text-zinc-500 font-semibold">Bauhaus</a> design.
      </p>

      <div class="flex flex-row gap-8 text-[18px] lg:text-xl text-zinc-500">
        <a href="/about" class="underline decoration-0">About</a>
        <a href="/projects" class="underline decoration-0">Projects</a>
        <a href="/blog" class="underline decoration-0">Blog</a>
      </div>
    </main>

    <footer class="flex flex-col gap-6 pt-32 sm:pt-28">
      <h3 class="text-[18px] lg:text-xl font-bold text-zinc-600">Contact</h3>
      <div class="flex flex-row gap-8 text-[16px] text-zinc-500">
        <a
          href="https://github.com/dwisarut"
          target="_blank"
          rel="noopener noreferer"
          class="underline">GitHub</a
        >
        <a
          href="https://linkedin.com/in/wisarut-donsri"
          target="_blank"
          rel="noopener noreferer"
          class="underline">LinkedIn</a
        >
        <a
          href="mailto:d.wisarut@hotmail.com"
          target="_blank"
          rel="noopener noreferer"
          class="underline">Email</a
        >
      </div>
    </footer>
  </div>
</MainLayout>
