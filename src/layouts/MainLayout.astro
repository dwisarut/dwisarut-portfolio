---
import "../styles/global.css";
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="dw_port.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <main class="flex flex-col container py-16 gap-8 md:gap-12">
      <slot>
        <div class="flex flex-col items-center py-12 gap-2">
          <h1 class="text-5xl font-bold">TBA</h1>
          <p class="text-xl">
            I will fill something here, please give me some time!
          </p>
        </div>
      </slot>
    </main>
  </body>
</html>
